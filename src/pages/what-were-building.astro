---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "What We’re Building | O2M Design";
const description = "Products and operating environments built by O2M Design, including Cognit Studio, Cognit Learning, and The Quiet Notebook.";
---

<BaseLayout title={title} description={description}>
  <main class="portfolio-page" aria-labelledby="portfolio-heading">
    <header class="portfolio-intro">
      <div class="portfolio-title">
        <div class="eyebrow">O2M Products &amp; Systems</div>
        <h1 id="portfolio-heading">What We’re Building</h1>
      </div>

      <div class="portfolio-narrative">
        <p class="portfolio-lead">
          <strong>Our work has increasingly moved beyond designing products for others. We also build and operate products of our own.</strong>
        </p>
        <p>
          The same ideas that shape our client work — continuity, clarity, thoughtful interaction, responsible intelligence, and systems that can evolve without losing their thread — now live in a growing family of products and environments.
        </p>
      </div>
    </header>

    <section class="product-portfolio" aria-label="Products and operating environments">
      <article class="product-entry">
        <div class="product-copy">
          <div class="product-index">01</div>
          <h2>Cognit Studio</h2>
          <p class="product-description">Connected products and systems for how people learn, think, create, work, and continue.</p>
          <p class="product-relationship">Cognit Studio is an operating brand of O2M Design, LLC.</p>
          <a href="https://cognitstudio.com" target="_blank" rel="noopener noreferrer">Visit Cognit Studio →</a>
        </div>

        <div class="product-visual cognit-studio-visual" aria-label="Reserved media area for future Cognit Studio product evidence">
          <div class="brand-field">
            <span>Operating brand</span>
            <strong>Cognit Studio</strong>
          </div>
          <p>Product evidence reserved for the next review.</p>
        </div>
      </article>

      <article class="product-entry product-entry-reverse">
        <div class="product-copy">
          <div class="product-index">02</div>
          <h2>Cognit Learning</h2>
          <p class="product-description">A connected learning product family built around the responsibilities of Centers, Coaches, Students, Families, and networks.</p>
          <p class="product-reference"><strong>Cognit Learning Hub</strong> is the current primary product within the Cognit Learning family.</p>
          <a href="https://cognitlearning.com" target="_blank" rel="noopener noreferrer">Visit Cognit Learning →</a>
        </div>

        <div class="product-visual cognit-learning-visual" aria-label="Reserved media area for future Cognit Learning Hub product evidence">
          <div class="brand-field">
            <span>Product family</span>
            <strong>Cognit Learning</strong>
            <small>Cognit Learning Hub</small>
          </div>
          <p>Learning Hub evidence reserved for the next review.</p>
        </div>
      </article>

      <article class="product-entry">
        <div class="product-copy">
          <div class="product-index">03</div>
          <h2>The Quiet Notebook</h2>
          <p class="product-description">An editorial and product environment for questions, reflection, and continuing thought.</p>
          <p class="product-reference"><strong>The Quiet Room / Quiet Corner</strong> are experiences within The Quiet Notebook environment.</p>
          <a href="https://thequietnotebook.com" target="_blank" rel="noopener noreferrer">Visit The Quiet Notebook →</a>
        </div>

        <div class="product-visual quiet-notebook-visual" aria-label="Reserved media area for future Quiet Notebook and Quiet Room product evidence">
          <div class="brand-field">
            <span>Editorial environment</span>
            <strong>The Quiet Notebook</strong>
            <small>The Quiet Room / Quiet Corner</small>
          </div>
          <p>Editorial evidence reserved for the next review.</p>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .portfolio-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 96px 20px 92px;
  }

  .portfolio-intro {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 76px;
    align-items: end;
    padding-bottom: 84px;
  }

  .portfolio-intro h1 {
    max-width: 460px;
    margin-bottom: 0;
    font-size: clamp(48px, 6.2vw, 76px);
  }

  .portfolio-narrative p {
    margin: 0 0 20px;
  }

  .portfolio-narrative p:last-child {
    margin-bottom: 0;
  }

  .portfolio-lead {
    font-size: 22px;
    line-height: 1.42;
  }

  .product-portfolio {
    border-top: 1px solid var(--line);
  }

  .product-entry {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 76px;
    align-items: stretch;
    padding: 76px 0;
    border-bottom: 1px solid var(--line);
  }

  .product-entry-reverse .product-copy {
    grid-column: 2;
  }

  .product-entry-reverse .product-visual {
    grid-column: 1;
    grid-row: 1;
  }

  .product-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .product-index {
    margin-bottom: 30px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .product-copy h2 {
    margin-bottom: 20px;
    font-size: clamp(34px, 3.8vw, 50px);
    line-height: 1.04;
  }

  .product-copy p {
    margin: 0 0 20px;
    font-size: 16px;
  }

  .product-copy .product-description {
    font-size: 20px;
    line-height: 1.45;
  }

  .product-relationship,
  .product-reference {
    color: var(--muted);
  }

  .product-copy a {
    margin-top: 10px;
    font-weight: 600;
  }

  .product-visual {
    min-height: 420px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--line);
    background: var(--card);
  }

  .product-visual::after {
    content: "";
    display: block;
    width: 42%;
    border-top: 1px solid var(--accent);
  }

  .product-visual p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  .brand-field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 390px;
  }

  .brand-field span {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-field strong {
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1;
  }

  .brand-field small {
    margin-top: 20px;
    color: var(--muted);
    font-size: 15px;
  }

  .cognit-studio-visual {
    background: #fff;
  }

  .cognit-learning-visual {
    background: #f1efea;
  }

  .quiet-notebook-visual {
    background: var(--text);
    color: #fff;
  }

  .quiet-notebook-visual .brand-field span,
  .quiet-notebook-visual .brand-field small,
  .quiet-notebook-visual p {
    color: #c8c8c8;
  }

  .quiet-notebook-visual::after {
    border-top-color: #fff;
  }

  @media (max-width: 820px) {
    .portfolio-page {
      padding-top: 72px;
    }

    .portfolio-intro {
      grid-template-columns: 1fr;
      gap: 34px;
      padding-bottom: 64px;
    }

    .product-entry {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px 0;
    }

    .product-entry-reverse .product-copy,
    .product-entry-reverse .product-visual {
      grid-column: 1;
      grid-row: auto;
    }

    .product-entry-reverse .product-copy {
      grid-row: 1;
    }

    .product-visual {
      min-height: 340px;
    }
  }

  @media (max-width: 520px) {
    .portfolio-page {
      padding-top: 58px;
      padding-bottom: 64px;
    }

    .portfolio-intro {
      gap: 28px;
      padding-bottom: 52px;
    }

    .portfolio-intro h1 {
      font-size: 48px;
    }

    .portfolio-lead {
      font-size: 20px;
    }

    .product-entry {
      gap: 34px;
      padding: 52px 0;
    }

    .product-visual {
      min-height: 270px;
      padding: 28px;
    }

    .brand-field strong {
      font-size: 34px;
    }
  }
</style>
